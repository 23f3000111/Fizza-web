# Copy to .env.local and fill in real values. Never commit .env.local.

# ── Admin panel ───────────────────────────────────────────────
# Password for /admin. Use a long, unique value — this is the only
# thing between the public internet and your listings. Do not reuse
# any password that has ever appeared in this repository.
ADMIN_PASSWORD=

# Signs the admin session cookie. Must be >= 32 random characters in
# production or the app refuses to start.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ── Branding / contact ────────────────────────────────────────
# Where contact-form and nightly lead emails are delivered.
CLIENT_EMAIL=
AGENT_WHATSAPP=60167533315

# ── Nightly leads email (SMTP) ────────────────────────────────
# Leave blank to disable sending — the CSV is still written to disk.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, use an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
